# Copy this file to .env for local use. On Vercel or Render, add these in the dashboard instead.
GEMINI_API_KEY=paste-your-key-here
# Optional: force a specific model. Default tries gemini-3.5-flash-lite, then gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Gemini Live voice id (Indian English female by default).
# GEMINI_LIVE_VOICE=en-in-concierge-2
